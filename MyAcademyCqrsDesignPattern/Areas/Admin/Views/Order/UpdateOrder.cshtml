@model UpdateOrderCommand
@{
    ViewData["Title"] = "UpdateOrder";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post" id="updateOrderForm">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="form-group mb-3">
        <label class="font-weight-bold">Sipariş Değeri</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="font-weight-bold">Sipariş Açıklaması</label>
        <textarea asp-for="OrderResult" class="form-control" rows="3"></textarea>
        <span asp-validation-for="OrderResult" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="font-weight-bold">Siparişi Veren</label>
        <select asp-items="@ViewBag.Customers" asp-for="CustomerId" class="form-control">
            <option value="">Lütfen Müşteri Seçiniz</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>

    <button type="button" onclick="confirmUpdate()" class="btn btn-success mt-2">
        <i class="fas fa-save"></i> Güncelle
    </button>
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmUpdate() {
        var price = document.getElementById("Price").value;
        var orderResult = document.getElementById("OrderResult").value;
        var customerId = document.getElementById("CustomerId").value;

        if (price.trim() === "" || orderResult.trim() === "" || customerId === "") {
            Swal.fire({
                icon: "error",
                title: "Eksik Bilgi!",
                text: "Lütfen tüm alanları doldurunuz."
            });
            return;
        }

        Swal.fire({
            title: "Güncellemek istediğinize emin misiniz?",
            text: "Sipariş bilgileri güncellenecektir.",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#28a745",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, güncelle!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("updateOrderForm").submit();
            }
        });
    }
</script>