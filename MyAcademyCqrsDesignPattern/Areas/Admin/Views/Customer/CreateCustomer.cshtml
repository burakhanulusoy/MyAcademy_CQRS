@model CreateCustomerCommand
@{
    ViewData["Title"] = "CreateCustomer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<form method="post">

    <div class="form-group mb-3">
        <label class="font-weight-bold">Müşteri Adı</label>
        <input asp-for="NameSurname" class="form-control" placeholder="Ürün adını giriniz..." />
        <span asp-validation-for="NameSurname" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="font-weight-bold">Şehir</label>
        <input asp-for="City" class="form-control" placeholder="Ürün adını giriniz..." />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="font-weight-bold">telefon</label>
        <input asp-for="PhoneNumber" class="form-control" placeholder="Ürün adını giriniz..." />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    
    <button class="btn btn-secondary">Ekle</button>


</form>

